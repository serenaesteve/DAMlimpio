    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER,
    user_agent TEXT,
    referer TEXT,
    accept_language TEXT,
    cookie TEXT,
    ip_address TEXT,
    request_uri TEXT,
